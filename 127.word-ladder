


```c++
class Solution {
public:
    int ladderLength(string beginWord, string endWord, vector<string>& wordList) {
        // wordList is just a dictonary, does not have order for the sequence
        // So we need to build a graph to if the next work is in the dictionary or not
        unordered_map<string, vector<string>> adjList;
        wordList.push_back(beginWord);
        // O(N)
        unordered_set<string> dict(wordList.begin(), wordList.end()); //O(N)

        // 26*N*K
        for (auto w: wordList) {
            vector<string> wordNext;
            // check if there are words, that are in the dict, and one letter different
            // hot --> aot...zot, hat...hzt, hoa...hoz ==> 26*k
            for (int i = 0; i < w.size(); i++) {
                for (char c = 'a'; c <= 'z'; c++) {
                    string _w = w; // copy to a new word
                    if (c != _w[i]){ // only compare if the word is not itself
                        _w[i] = c;
                        if (dict.find(_w) != dict.end()) {
                            wordNext.push_back(_w);
                        }
                    }
                }
            }
            adjList[w] = wordNext;
        }

        // do bfs ==> O(N)
        // because the graph is bi-directional, say hit -> hot, hot -> hit
        // so we want a visited list
        int step = 0;
        queue<string> q;
        unordered_set<string> visited;
        q.push(beginWord);
        while(!q.empty()) {
            int s = q.size();
            for (int i = 0; i < s; ++i) {
                string curr = q.front();
                q.pop();
                visited.insert(curr);
                if (curr == endWord)
                    return step+1;
                for(auto &next : adjList[curr]) {
                    if (visited.find(next) == visited.end())
                        q.push(next);
                }
            }
            step++;
        }
        return 0;
    }
};


// every adjacent pair diff by single letter
