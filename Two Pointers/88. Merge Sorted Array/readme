Option#1: use a new array:

- Time O(m+n)
- space O(m+n)

```c++
class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
        int i = 0;
        int j = 0;
        int k = 0;
        vector<int> res(nums1.size(), 0); 

        while(k < res.size()) {
            if (i == m) {
                res[k] = nums2[j];
                j++;
                k++;
                continue;
            } 
            if (j == n) {
                res[k] = nums1[i];
                i++;
                k++;
                continue;
            }

            if(nums1[i] <= nums2[j]) {
                res[k] = nums1[i];
                i++;
                k++;
            } else {
                res[k] = nums2[j];
                j++;
                k++;
            }
        }

        for(int i = 0; i < nums1.size(); ++i)
            nums1[i] = res[i];
    }
};
```

Option#2: because the back of nums1 are 0s, so we sort from back reversely (from larger to samll)
    if we sort large -> small, from back to front, then the numbers in remains in nums1 are safe to overridden.

```c++
class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
        int i = nums1.size()-n-1;
        int j = nums2.size()-1;
        int k = nums1.size()-1;

        while(k > -1) {
            if(i < 0) {
                nums1[k] = nums2[j];
                --k;
                --j;
                continue;
            }
            if(j < 0) {
                nums1[k] = nums1[i];
                --k;
                --i;
                continue;
            }

            if(nums1[i] >= nums2[j]){
                nums1[k] = nums1[i];
                --k;
                --i;
            }else {
                nums1[k] = nums2[j];
                --k;
                --j;
                continue;
            }
        }
    }
};


// reverse sort
// [1,2,3,0,0,0]
//      i     k
// [2,5,6]
//.      j
```
