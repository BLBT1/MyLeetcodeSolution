扫描线 --> give a list of intervals, find at most how many overlaps

我们只关心区间的起点和终点，不然没有状态的变化

把所有的点按照起点和终点排序，是起点就+1， 是终点就-1， 然后就能知道多少区间overlap

更简单点思想就是， 如果我们按照meeting 开始时间排序，那前一个meeting的start time 必须小于后一个meeting的end time

```c++
class Solution {
public:
    static bool isBefore(const pair<int, int>& a, const pair<int, int>& b) {
        if (a.first != b.first) {
            return a.first < b.first;
        }
        // whoever is end point should come first, end point is -1, so smaller come first
        return a.second < b.second;
    }

    bool canAttendMeetings(vector<vector<int>>& intervals) {
        vector<pair<int, int>> points;


        for (auto& interval : intervals) {
                points.push_back({interval[0], 1}); 
                points.push_back({interval[1], -1}); 
            }


        // if begin end overlaps, can attend the meeting
        // sort by begin, if begin, end at the same time, cannot attend, so end goes first
        sort(points.begin(), points.end(), isBefore);

        // any time overlap is > 1, cannot attend all meetings
        int overlaps = 0;
        for (auto &p : points)
        {
            overlaps += p.second;

            if (overlaps > 1) 
            {
                return false;
            }
        }

        return true;
    }
};
```

解法1：扫描线
```go
func canAttendMeetings(intervals [][]int) bool {
    type point struct{
        time int
        change int // at begin change to overlap is +1, at end change to overlap is -1
    }

    points := make([]point, 0, 2*len(intervals))    
    for _,interval := range intervals {
        points = append(points, point{time: interval[0], change: 1})
        points = append(points, point{time: interval[1], change: -1})
    }

    comp := func(a point, b point) int {
        if a.time < b.time {
            return -1
        } else if a.time == b.time {
            if a.change < b.change {
            // whatever point is -1 (end of interval) come first
                return -1;
            } else {
                return 1;
            }
        } else {
            return 1
        }
    }

    slices.SortFunc(points, comp);

    overlap := 0;
    for _, p := range points {
        overlap += p.change

        if overlap > 1 {
            return false
        }
    }
    return true
}
```

解法2: 贪心
```go
func canAttendMeetings(intervals [][]int) bool {
    // 按照开始时间排序 ， 前一个meeting的end time 要小于后一个meeting的start time
    sort.Slice(intervals, func(i, j int) bool {
        return intervals[i][0] < intervals[j][0]
    })

    for i := 0; i < len(intervals)-1; i++ {
        if intervals[i][1] > intervals[i+1][0] {
            return false
        }
    }
    return true
}
```